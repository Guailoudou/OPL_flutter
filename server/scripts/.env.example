# SFTP 连接配置
SFTP_HOST=your-server.com
SFTP_PORT=22
SFTP_USER=your-username

# 认证方式（二选一）
# 方式1：使用 SSH 私钥
SFTP_KEY=/path/to/your/private/key

# 方式2：使用密码
# SFTP_PASS=your-password

# 远程目录配置
SFTP_REMOTE=/file/releases

# 文件下载基础 URL（用于生成 releases.json 中的下载链接）
RELEASES_URL=https://file.gldhn.top/file/releases

# Flutter SDK 路径（可选，默认使用系统 PATH 中的 flutter）
# FLUTTER_ROOT=/path/to/flutter
